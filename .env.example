# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. https://ais-dev-....run.app).
# AI Studio automatically injects this or it can be set manually.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_A_TOKEN: Bot token for Bot A from @BotFather
TELEGRAM_BOT_A_TOKEN=""

# TELEGRAM_BOT_B_TOKEN: Bot token for Bot B from @BotFather
TELEGRAM_BOT_B_TOKEN=""

# PORT: Server port (defaults to 3000)
PORT="3000"
